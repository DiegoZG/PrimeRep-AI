# Use your machine's LAN address for a physical device during local development.
EXPO_PUBLIC_API_URL=http://192.168.86.30:8000

# Public contact shown in Terms and Privacy. Use a monitored inbox in release builds.
EXPO_PUBLIC_LEGAL_EMAIL=legal@your-domain.example

# Monitored support inbox, required for production builds.
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain.example

# Public Apple SDK key only; leave blank until RevenueCat/Apple are configured.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
# Only preview accepts a RevenueCat Test Store key. Real Apple sandbox still uses appl_.
EXPO_PUBLIC_BILLING_ENV=production
