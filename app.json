{
  "expo": {
    "name": "PrimeRep-AI",
    "slug": "PrimeRep-AI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "primerepai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diegozegarra.primerep"
    },
    "android": {
      "package": "com.diegozegarra.primerep",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.WRITE_EXERCISE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "PrimeRep uses your selected photo for your private profile.", "cameraPermission": false, "microphonePermission": false }],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-video",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "PrimeRep reads your steps and sleep to offer optional, private workout context.",
          "NSHealthUpdateUsageDescription": "PrimeRep saves workouts you complete in the app to Apple Health when you choose to export them.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3353e059-435f-4519-9c55-0985b7bc3b44"
      }
    },
    "owner": "diegozegarra78"
  }
}
